%% MOS Transistor - Virtuoso
\newcommand{\mostransistorcds}[7]{%{position}{name}{n/p}{terminals, case, dot, arrow}{rotation,flip(h, v, hv, or none)}{grid}{show (0,0)}
% enabled
% category: Virtuoso
% scales: 1, 2, 4
% label_anchor: -10 -25 L
% flip: enabled
% preview_args: 3=n, 4=case, arrow

% arg_def: 3 | select | n/p | n | n,p
% arg_def: 4 | flags | terminal names / case | | terminals, case
% arg_def: 4 | select | dot/arrow notation | arrow | dot, arrow
% arg_def: 5 | rotflip | Rotation & Flip | 0,none

% icon_base: M -2 -20 L -2 20 M -30 0 L -18 0 M 10 -30 L 10 -15 L -2 -15 M -2 15 L 10 15 L 10 30 // base layer
% add_icon: 1~= : [stroke-width=3.3] M -10 -15 L -10 15 // gate line
% add_icon: 3==n : M -18 0 L -10 0 // n gate segment (bridges the base line to the gate)
% add_icon: 3==n && 4~=arrow : [rounded=true] M 10 15 L 6 12 L 10 15 L 6 18 // n arrow
% add_icon: 3==p && 4~=arrow : [rounded=true] M -2 15 L 2 12 L -2 15 L 2 18 // p arrow
% add_icon: 3==p && 4~=arrow : M -18 0 L -10 0 // p gate segment (bridges the gap if no dot)
% add_icon: 3==p && 4~=dot : M -15 0 m -3 0 a 3 3 0 1 0 6 0 a 3 3 0 1 0 -6 0 M -12 0 L -10 0 // p dot AND the bridge to the gate
% add_icon: 4~=case : M 0 0 m -25 0 a 25 25 0 1 0 50 0 a 25 25 0 1 0 -50 0 // case
% add_icon: 4~=terminals : M -31 6 L -31 6 /*TEXT:10,normal,G*/ M 15 -30 L 15 -30 /*TEXT:10,normal,D*/ M 15.50 27 L 15.50 27 /*TEXT:10,normal,S*/ // terminal names
    \StrBefore{#5}{,}[\rotationvalue]
	\StrBehind{#5}{,}[\flipvalue]
	\IfSubStr{\flipvalue}{h}
			{
				\edef\xscalevalue{-1}
			}
			{
				\edef\xscalevalue{1}
			}
		\IfSubStr{\flipvalue}{v}
			{
				\edef\yscalevalue{-1}
			}
			{
				\edef\yscalevalue{1}
			}
		\begin{scope}[shift={#1}, scale=\jlcscale, rotate=\rotationvalue, xscale=\xscalevalue , yscale=\yscalevalue]
				\getzoomfactor
				% draw case
					\IfSubStr{#4}{case}
						{
							\draw[line width=\linewidthscalefactor * \zoomfactor * 1pt]  (0,0) circle (3);
							\edef\nameposition{3}
						}
						{
							\edef\nameposition{2.5}
						}
				% draw body
					\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt] (-4,0) -- (-1.7,0);
					\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt] (1,4) -- (1,1.5) -- (-0.5,1.5);
					\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt] (1,-4) -- (1,-1.5) -- (-0.5,-1.5);
					\draw [line width=\linewidthscalefactor * \zoomfactor * 4pt] (-1.7,-1.5) -- (-1.7,1.5);
					\draw [line width=\linewidthscalefactor * \zoomfactor * 3.5pt] (-0.5,-2.2) -- (-0.5,2.2);
				% draw source arrow / gate dot
					\ifstrequal{#3}{n}
						{
							\IfSubStr{#4}{arrow}
								{
									\draw [->, >=latex, line width=\linewidthscalefactor * \zoomfactor * 1.5pt]  (-0.5,-1.5) -- (1,-1.5);
								}
								{
								}
							
						}
						{
							\IfSubStr{#4}{arrow}
								{
									\draw [->, >=latex, line width=\linewidthscalefactor * \zoomfactor * 1.5pt]  (1,-1.5) -- (-0.5,-1.5);
								}
								{
									\IfSubStr{#4}{dot}
										{
											\filldraw[color=white, line width=\linewidthscalefactor * \zoomfactor * 1.2pt]  ({-2.1cm-\linewidthscalefactor * \zoomfactor * 3.2pt},0) circle (0.4);
											\draw[line width=\linewidthscalefactor * \zoomfactor * 1.2pt]  ({-2.1cm-\linewidthscalefactor * \zoomfactor * 3.2pt},0) circle (0.4);										
										}
										{
										}
								}					
						}
				% draw terminals
					\IfSubStr{#4}{terminals}
						{
							\node[draw=none, align=center] at (-4,1 * \yscalevalue) {G};
							\node[draw=none, align=center] at (2,4) {D};
							\node[draw=none, align=center] at (2,-4) {S};
						}
						{
						}
				% draw name
					\node[draw=none, align=center] at (-1*\nameposition ,\nameposition * \yscalevalue) {#2};
				% draw grid
					\ifstrequal{#6}{gridon}
						{
							\draw[step=1cm,color=gray] (-4,-4) grid (4,4);
						}
						{
						}
				% draw (0,0)
					\ifstrequal{#7}{show}
						{
							\node[draw=none, align=center, color=red] at (0,0) {#1};
						}
						{
						}
            \coordinate (pin1) at (-3.00, 0.00); % left terminal (gate) [R]
        \coordinate (pin2) at (1.00, 3.00); % top terminal (drain) [R]
        \coordinate (pin3) at (1.00, -3.00); % bottom terminal (source) [R]
    \end{scope}
}

