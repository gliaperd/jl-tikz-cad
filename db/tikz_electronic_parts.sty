					{
						\ADD{0}{\numberofselectterminalsfloor}{\numberofselectterminals}
					}
					{
						\ADD{1}{\numberofselectterminalsfloor}{\numberofselectterminals}
					}
				\ADD{1}{\numberofselectterminals}{\muxrectanglewidth}				
				\ADD{1}{#3}{\muxrectangleheight}

				% JS Logic for spacing and offset (spacing = 2 for n=2, else 1)
				\pgfmathsetmacro{\inputspacing}{#3 == 2 ? 2 : 1}
				\pgfmathsetmacro{\inputyoffset}{#3 == 2 ? -1 : 0}
				
				\foreach \currentinput in {1,...,#3} % draw input lines
					{
