% let isTop = args[5] === 'top';
% 
% let numSelects = Math.ceil(Math.log2(n));
% let w = numSelects + 1; // Width of the mux body
% let h = (n === 2) ? n*spacing: (n + 1)*spacing;  // Height of the mux body
% 
% let tikz = new TikZBuilder();
% 
% // 1. Draw Inputs & Input Pins
