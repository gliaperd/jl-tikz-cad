% let selY2 = isTop ? (h + 1) : -1; // The outer tip of the pin
% 
% for (let i = 1; i <= numSelects; i++) {
%     let selX = 1 + i;
%     
%     // --- THE EXACT SLANT INTERSECTION ---
%     // Because the slope is 0.4, for every 'i' units we move right, 
%     // the slant moves exactly 0.4 * i units vertically!
%     let selY1 = isTop ? (h - 0.4 * i) : (0.4 * i); 
%     
%     tikz.draw(selX, selY1).to(selX, selY2);
