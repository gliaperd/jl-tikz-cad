								\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt]  (1 + \currentselectterminal, \selY)  -- (1 + \currentselectterminal,  -1); 
								\SUBTRACT{\numberofselectterminals}{\currentselectterminal}{\currentselectterminalindex}
								\IfEq{\numberofselectterminals}{1}
									{
										\node[draw=none, align=center] at (1.5 + \currentselectterminal,-0.5) {s}; % draw select symbols
									}
									{
										\node[draw=none, align=center] at (1.5 + \currentselectterminal,-0.5) {s\textsubscript{\currentselectterminalindex}}; % draw select symbols
									}
							}
						\ifstrequal{#2}{}	
							{
							}
							{					
								\node[draw=none, align=center] at ({1 + (\muxrectanglewidth / 2)},\muxheight+1) {#2}; % draw name at top
							}
					}

				% draw body
					\pgfmathsetmacro{\inputY}{ceil((#3+1)/2)}
					\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt]  (0, \inputY)  -- (1, \inputY); % draw input line
					\node[draw=none, align=center] at (0.5, \inputY + 0.5) {I}; % draw input symbol
					
					\shade[left color=gray!50!white, draw=none] (1, 0.4 * \muxrectanglewidth) -- (1, \muxheight - 0.4 * \muxrectanglewidth) -- (1 + \muxrectanglewidth, \muxheight) -- (1 + \muxrectanglewidth, 0) -- cycle; % draw shade
					\draw  [line width=\linewidthscalefactor * \zoomfactor * 1pt, color=gray!70]  (1, 0.4 * \muxrectanglewidth) -- (1 + \muxrectanglewidth, \muxheight); % draw diagonal
					\draw  [line width=\linewidthscalefactor * \zoomfactor * 1.5pt]  (1, 0.4 * \muxrectanglewidth) -- (1, \muxheight - 0.4 * \muxrectanglewidth) -- (1 + \muxrectanglewidth, \muxheight) -- (1 + \muxrectanglewidth, 0) -- cycle;  % draw box
					
					% define dummy nodes
						\node[draw=none] (BL) at (1, 0.4 * \muxrectanglewidth) {}; % bottom-left body corner
						\node[draw=none] (TL) at (1, \muxheight - 0.4 * \muxrectanglewidth) {}; % top-left body corner
						\node[draw=none] (TR) at (1 + \muxrectanglewidth, \muxheight) {}; % top-right body corner
						\node[draw=none] (BR) at (1 + \muxrectanglewidth, 0) {}; % bottom-right body corner
					%place numbers 
						\node[draw=none, align=center] at  (barycentric cs:BL=1/3,TL=1/3,TR=1/3) {1}; % draw number of inputs
						\node[draw=none, align=center] at  (barycentric cs:BL=1/3,BR=1/3,TR=1/3) {#3}; % draw number of outputs

				% other options
				\ifstrequal{#6}{gridon}
					{
						\draw[step=1cm,color=gray] (0,-1) grid (\muxrectanglewidth + 2,#3+2);
					}
					{
					}
				\ifstrequal{#7}{show}
					{
						\node[draw=none, align=center, color=red] at (0,0) {#1};
					}
					{
					}
		    \end{scope}
}

