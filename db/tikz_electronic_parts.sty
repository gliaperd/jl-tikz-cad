%% Mechanical Switch
\newcommand{\mechanicalswitch}[7]{%{position}{name}{closed/open}{state}{rotation}{grid}{show (0,0)}
% enabled
% category: Switches
% scales: 1, 2, 4
% label_anchor: B
% flip: disabled
% preview_args: 3=open

% arg_def: 3 | select | closed/open | open | closed, open
% arg_def: 4 | text | state tag | 
% arg_def: 5 | rotation | Rotation | 0


% icon_base: [fill=solid] M 30 0 L 40 0 M 30 0 A 1 1 0 1 0 28 -1 A 1 1 0 1 0 30 0 Z M 0 0 L 10.5 0 // base
% add_icon: 3==closed : [fill=solid] M 10 0 L 27 -2 M 28 -1 A 1 1 0 1 0 27 -3 A 1 1 0 1 0 28 -1 Z // closed
% add_icon: 3==open : [fill=solid] M 10 0 L 28 -11 M 29 -11 A 1 1 0 1 0 27 -11 A 1 1 0 1 0 29 -11 Z // open
    \begin{scope}[shift={#1}, scale=\jlcscale, rotate=#5]
				\getzoomfactor
				% draw terminals
					\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt] (0,0)  -- (1,0);
					\filldraw  (1,0) circle(0.25);
					\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt] (3,0)  -- (4,0);
					\filldraw  (3,0) circle (0.25);
				% draw bridge
					\ifstrequal{#3}{closed}
						{
							\draw [line width=\linewidthscalefactor * \zoomfactor * 1.7pt] (3,0)  -- (1,0.25);
							\node[draw=none, align=center] at (2,1.2) {\textbf{#4}}; % draw state
						}
						{
							\draw [line width=\linewidthscalefactor * \zoomfactor * 1.7pt] (3,0)  -- (1.2,1.2);
							\node[draw=none, align=center] at (2,2) {\textbf{#4}}; % draw state
						}
				% draw name
					\node[draw=none, align=center] at (2,-1) {#2};

				\ifstrequal{#6}{gridon}
					{
						\draw[step=1cm,color=gray] (0,-1) grid (4,3);
					}
					{
					}
				\ifstrequal{#7}{show}
					{
						\node[draw=none, align=center, color=red] at (0,0) {#1};
					}
					{
					}
            \coordinate (pin1) at (0.00, 0.00); % left terminal  [R]
        \coordinate (pin2) at (4.00, 0.00); % right terminal  [R]
        \coordinate ($4) at (1.95, 0.55); % [T] IF:3==closed
        \coordinate ($4) at (1.70, 1.10); % [T] IF:3==open
    \end{scope}
}

%% Three-Port Mechanical Switch
\newcommand{\mechanicalswitchthreeport}[6]{%{position}{name}{state1/state2}{rotation}{grid}{show (0,0)}
% enabled
% category: Switches
% scales: 1, 2, 4
% label_anchor: B
% flip: disabled
% preview_args: 3=state1

% arg_def: 3 | select | state1/state2 | state1 | state1, state2
% arg_def: 4 | rotation | Rotation | 0


% icon_base: [fill=solid] M 0 0 L 10 0 M 0 -20 L 10 -20 M 30 -10 L 40 -10 M 11 0 A 1 1 0 1 0 9 0 A 1 1 0 1 0 11 0 Z M 11 -20 A 1 1 0 1 0 9 -20 A 1 1 0 1 0 11 -20 Z M 30 -10 m -0.5 0 a 0.5 0.5 0 1 0 1 0 a 0.5 0.5 0 1 0 -1 0 // terminals
% add_icon: 3==state1 : M 9 -2 L 30 -10 M 11 -2 A 1 1 0 1 0 9 -2 A 1 1 0 1 0 11 -2 Z // state-1
% add_icon: 3==state2 : M 9 -18 L 30 -10 M 11 -18 A 1 1 0 1 0 9 -18 A 1 1 0 1 0 11 -18 Z // state-2
    \begin{scope}[shift={#1}, scale=\jlcscale, rotate=#4]
				\getzoomfactor
				% draw terminals
					\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt] (0,0)  -- (1,0);
					\filldraw  (1,0) circle(0.25);
					\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt] (0,2)  -- (1,2);
					\filldraw  (1,2) circle(0.25);
					\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt] (3,1)  -- (4,1);
					\filldraw  (3,1) circle (0.25);
				% draw bridge
					\ifstrequal{#3}{state1}
						{
							\draw [line width=\linewidthscalefactor * \zoomfactor * 1.7pt] (3,1)  -- (0.8,0.25);
						}
						{
							\draw [line width=\linewidthscalefactor * \zoomfactor * 1.7pt] (3,1)  -- (0.8,1.75);
						}
				% draw name
					\node[draw=none, align=center] at (2,-1) {#2};

				\ifstrequal{#5}{gridon}
					{
						\draw[step=1cm,color=gray] (0,-1) grid (4,3);
					}
					{
					}
				\ifstrequal{#6}{show}
					{
						\node[draw=none, align=center, color=red] at (0,0) {#1};
					}
					{
					}
            \coordinate (pin1) at (0.00, 0.00); % bottom left terminal  [R]
        \coordinate (pin2) at (0.00, 2.00); % top left terminal  [R]
        \coordinate (pin3) at (4.00, 1.00); % right terminal  [R]
    \end{scope}
}

%% Controlled Switch
\newcommand{\controlledswitch}[7]{%{position}{name}{closed/open}{control_terminal}{rotation}{grid}{show (0,0)}
% enabled
% category: Switches
% scales: 1, 2, 4
% label_anchor: B
% flip: disabled
% preview_args: 3=open

% arg_def: 3 | select | closed/open | open | closed, open
% arg_def: 4 | text | control_terminal | 
% arg_def: 5 | rotation | Rotation | 0


% icon_base: [fill=solid] M 0 0 L 10 0 M 30 0 L 40 0 M 30 0 A 1 1 0 1 0 28 -1 A 1 1 0 1 0 30 0 Z M 20 -13 L 20 -15 M 19 -15 L 21 -15 M 15 -15 L 25 -15 M 10 0 m -0.5 0 a 0.5 0.5 0 1 0 1 0 a 0.5 0.5 0 1 0 -1 0 // base
% add_icon: 3==closed : [fill=solid] M 10 0 L 27 -2 M 28 -1 A 1 1 0 1 0 27 -3 A 1 1 0 1 0 28 -1 Z M 20 -1 L 20 -2 M 20 -3 L 20 -4 M 20 -5 L 20 -6 M 20 -7 L 20 -8 M 20 -9 L 20 -10 M 20 -11 L 20 -12 // closed
% add_icon: 3==open : [fill=solid] M 10 0 L 28 -11 M 29 -11 A 1 1 0 1 0 27 -11 A 1 1 0 1 0 29 -11 Z M 20 -6 L 20 -7 M 20 -8 L 20 -9 M 20 -10 L 20 -11 M 20 -12 L 20 -13 M 20 -14 L 20 -15 // open
    \begin{scope}[shift={#1}, scale=\jlcscale, rotate=#5]
				\getzoomfactor
				% draw terminals
					\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt] (0,0)  -- (1,0);
					\filldraw  (1,0) circle(0.25);
					\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt] (3,0)  -- (4,0);
					\filldraw  (3,0) circle (0.25);
				% draw control terminal
					\ifstrequal{#4}{}
						{
						}
						{
							\draw [line width=\linewidthscalefactor * \zoomfactor * 2pt] (1.5,2)  -- (2.5,2);
							\node[draw=none, align=center] at (2,3) {#4};
							\ifstrequal{#3}{closed}
								{
									\draw [dashed, line width=\linewidthscalefactor * \zoomfactor * 1.2pt] (2,2)  -- (2,0.1);
								}
								{
									\draw [dashed, line width=\linewidthscalefactor * \zoomfactor * 1.2pt] (2,2)  -- (2,0.75);
								}
						}
				% draw bridge
					\ifstrequal{#3}{closed}
						{
							\draw [line width=\linewidthscalefactor * \zoomfactor * 1.7pt] (3,0)  -- (1,0.25);
						}
						{
							\draw [line width=\linewidthscalefactor * \zoomfactor * 1.7pt] (3,0)  -- (1.2,1.2);
						}
				% draw name
					\node[draw=none, align=center] at (2,-1) {#2};

				\ifstrequal{#6}{gridon}
					{
						\draw[step=1cm,color=gray] (0,-1) grid (4,3);
					}
					{
					}
				\ifstrequal{#7}{show}
					{
						\node[draw=none, align=center, color=red] at (0,0) {#1};
					}
					{
					}
            \coordinate (pin1) at (0.00, 0.00); % left terminal  [R]
        \coordinate (pin2) at (4.00, 0.00); % right terminal  [R]
        \coordinate ($4) at (2.00, 1.75); % [T]
    \end{scope}
}

%% Controlled Switch - Box
\newcommand{\controlledswitchbox}[7]{%{position}{name}{control value}{n/p}{rotation}{grid}{show (0,0)}
% enabled
% category: Switches
% scales: 1, 2, 4
% label_anchor: 24 5 B
% flip: disabled
% preview_args: 4=n, 5=0

% arg_def: 3 | text | control value | 
% arg_def: 4 | select | type | n | n, p
% arg_def: 5 | rotation | Rotation | 0

% icon_base: [fill=solid] M 0 0 L 10 0 M 30 0 L 40 0 M 10 0 L 28 -11 M 10 0 m -0.5 0 a 0.5 0.5 0 1 0 1 0 a 0.5 0.5 0 1 0 -1 0 // Base terminals and angled bridge
% add_icon: 1~= : M 9 -13 L 32 -13 L 32 4 L 9 4 Z // The thick main box
% add_icon: 1~= : [stroke-width=2.8] M 16 -23 L 24 -23 // T
% add_icon: 1~= : [fill=solid] M 30 0 A 1 1 0 1 0 28 -1 A 1 1 0 1 0 30 0 Z M 29 -11 A 1 1 0 1 0 27 -11 A 1 1 0 1 0 29 -11 Z // Solid pivot circles
% add_icon: 4==n : [stroke-width=1.6] M 20 -22.5 L 20 -12.5 // N-line
% add_icon: 4==p : [stroke-width=1.6] M 20 -22 L 20 -18.5 // P-line
% add_icon: 4==p : [stroke-width=0.7] M 20 -16 m -2.5 0 a 2.5 2.5 0 1 0 5 0 a 2.5 2.5 0 1 0 -5 0 // inversion bubble
    \begin{scope}[shift={#1}, scale=\jlcscale, rotate=#5]
				\getzoomfactor
				% handle inverted control value
					\edef\effectiveswitchtype{#4}	
					\IfEndWith{#3}{*}
						{
							\ifstrequal{#4}{n}
								{
									\edef\effectiveswitchtype{p}
								}
								{
									\edef\effectiveswitchtype{n}
								}	
						}
						{
						}
				% choose box color
					\ifstrequal{#4}{n}
						{
							\edef\controlledswitchboxcolor{green}
						}
						{
							\edef\controlledswitchboxcolor{red}
						}
				% draw box
					\shade[left color=\controlledswitchboxcolor!30!white, draw=none] (0.5,-0.5) rectangle (3.5,1.5) (4,0);
					\draw [line width=\linewidthscalefactor * \zoomfactor * 0.75pt] (0.5,-0.5) rectangle (3.5,1.5) (4,0);
				% draw terminals
					\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt] (0,0)  -- (1,0);
					\filldraw  (1,0) circle(0.25);
					\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt] (3,0)  -- (4,0);
					\filldraw  (3,0) circle (0.25);
				% draw control terminal
					\draw [line width=\linewidthscalefactor * \zoomfactor * 2pt] (1.5,3)  -- (2.5,3);
					\IfEndWith{#3}{*}
						{
							\node[draw=none, align=center] at (2,4) {\StrBefore{#3}{*}};	
						}
						{
							\node[draw=none, align=center] at (2,4) {#3};	
						}									
				% draw bridge
					\ifstrequal{#3}{1}
						{
							\IfStrEq{\effectiveswitchtype}{n}
								{
									\draw [dashed, line width=\linewidthscalefactor * \zoomfactor * 1.2pt] (2,3)  -- (2,0.1);
									\draw [line width=\linewidthscalefactor * \zoomfactor * 1.7pt] (3,0)  -- (1,0.25); %closed
								}
								{
									\draw [line width=\linewidthscalefactor * \zoomfactor * 1.7pt] (3,0)  -- (1.2,1.2); %open
									\draw [dashed, line width=\linewidthscalefactor * \zoomfactor * 1.2pt] (2,3)  -- (2,0.75);
								}
						}
						{
							\ifstrequal{#3}{0}
								{
									\IfStrEq{\effectiveswitchtype}{n}
										{
											\draw [line width=\linewidthscalefactor * \zoomfactor * 1.7pt] (3,0)  -- (1.2,1.2); %open	
											\draw [dashed, line width=\linewidthscalefactor * \zoomfactor * 1.2pt] (2,3)  -- (2,0.75);								
										}
										{
											\draw [dashed, line width=\linewidthscalefactor * \zoomfactor * 1.2pt] (2,3)  -- (2,0.1);
											\draw [line width=\linewidthscalefactor * \zoomfactor * 1.7pt] (3,0)  -- (1,0.25); %closed									
										}
								}
								{
									\IfStrEq{\effectiveswitchtype}{p}
										{
											\draw [line width=\linewidthscalefactor * \zoomfactor * 1.7pt] (3,0)  -- (1.2,1.2); %open	
											\draw [dashed, line width=\linewidthscalefactor * \zoomfactor * 1.2pt] (2,3)  -- (2,0.75);
										}
										{
											\draw [dashed, line width=\linewidthscalefactor * \zoomfactor * 1.2pt] (2,3)  -- (2,0.1);
											\draw [line width=\linewidthscalefactor * \zoomfactor * 1.7pt] (3,0)  -- (1,0.25); %closed	
										}
									
								}
						}
				% draw name
					\node[draw=none, align=center] at (2,-1) {#2};
				% draw dot
					\ifstrequal{#4}{p}
						{
							\filldraw[color=white, line width=\linewidthscalefactor * \zoomfactor * 1pt]  (2,1.8) circle (0.3);
							\draw[line width=\linewidthscalefactor * \zoomfactor * 1pt]  (1.3,0) (2,1.8) circle (0.3);
						}
						{
						}
				% draw grid
					\ifstrequal{#6}{gridon}
						{
							\draw[step=1cm,color=gray] (0,-1) grid (4,3);
						}
						{
						}
				% draw (0,0)
					\ifstrequal{#7}{show}
						{
							\node[draw=none, align=center, color=red] at (0,0) {#1};
						}
						{
						}
            \coordinate (pin1) at (0.00, 0.00); % left terminal  [R]
        \coordinate (pin2) at (4.00, 0.00); % right terminal  [R]
        \coordinate ($3) at (2.00, 2.50); % [T]
    \end{scope}
}


%% Ground Terminal
\newcommand{\groundterminal}[5]{%{position}{name}{rotation,flip(h, v, hv, or none)}{grid}{show (0,0)}
% enabled
% category: Terminals
% scales: 1, 2, 4
% label_anchor: 0 35 B
% flip: disabled

% arg_def: 3 | rotflip | Rotation & Flip | 0,none


% icon_base: M 0 0 L 0 15 // The vertical entry lead
% add_icon: 1~= : [stroke-width=4.5] M -15 15 L 15 15 // Top bar (Thickest)
% add_icon: 1~= : [stroke-width=3.5] M -10 22 L 10 22 // Middle bar (Medium)
% add_icon: 1~= : [stroke-width=3.0] M -5 29 L 5 29 // Bottom bar (Thinnest)
    \IfSubStr{#3}{h}
			{
				\edef\xscalevalue{-1}
				\edef\groundnameanchorstring{east}
			}
			{
				\edef\xscalevalue{1}
				\edef\groundnameanchorstring{west}
			}
		\IfSubStr{#3}{v}
			{
				\edef\yscalevalue{-1}
			}
			{
				\edef\yscalevalue{1}
			}
		\StrBefore{#3}{,}[\groundrotationangle]
		\ifx\groundrotationangle\@empty%
			\edef\groundrotationangle{0}%
		\fi%
		\begin{scope}[shift={#1}, scale=\jlcscale, rotate=\groundrotationangle , xscale=\xscalevalue , yscale=\yscalevalue]
				\getzoomfactor
				% draw terminal
					\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt] (0,-1)  -- (0,0);
				% draw lines
					\draw [line width=\linewidthscalefactor * \zoomfactor * 2.2pt] (-1,-1)  -- (1,-1);
					\draw [line width=\linewidthscalefactor * \zoomfactor * 2pt] (-0.5,-1.5)  -- (0.5,-1.5);
					\draw [line width=\linewidthscalefactor * \zoomfactor * 2pt] (-0.25,-2)  -- (0.25,-2);
				% draw name
					\node[draw=none, anchor=\groundnameanchorstring] at (0.5,0) {#2};

				\ifstrequal{#4}{gridon}
					{
						\draw[step=1cm,color=gray] (-2,-2) grid (2,2);
					}
					{
					}
				\ifstrequal{#5}{show}
					{
						\node[draw=none, align=center, color=red] at (0,0) {#1};
					}
					{
					}
		        \coordinate (pin1) at (0.00, 0.00); % top terminal  [R]
    \end{scope}
}

%% Voltage Source (Independent/Controlled)
\newcommand{\voltagesource}[7]{%{position}{name}{horizontal/vertical}{standard/controlled}{rotation}{grid}{show (0,0)}
% enabled
% category: Sources
% scales: 1, 2, 4
% label_anchor: B
% flip: disabled
% spice_template: V_{NAME} {pin1} {pin2} {SIGNAL}
% preview_args: 3=none, 4=standard, 5=0

% arg_def: 3 | select | horizontal/vertical | none | horizontal, vertical, none
% arg_def: 4 | select | type | standard | standard, controlled
% arg_def: 5 | rotation | Rotation | 0

% icon_base: M -30 0 L -20 0 M 20 0 L 30 0 M -12 0 L -4 0 M -8 -4 L -8 4 M 4 0 L 12 0 // Leads and internal +/- polarity
% add_icon: 4==standard : [stroke-width=2.5] M 0 0 m -20 0 a 20 20 0 1 0 40 0 a 20 20 0 1 0 -40 0 // Thicker circular shell
% add_icon: 4==controlled : [stroke-width=2.5] M -20 0 L 0 -20 L 20 0 L 0 20 L -20 0 // Thicker diamond shell
    \begin{scope}[shift={#1}, scale=\jlcscale, rotate=#5]
				\getzoomfactor
				% Draw body
				\ifstrequal{#4}{controlled}
					{
						% Diamond shape for controlled source
						\draw[line width=\linewidthscalefactor * \zoomfactor * 1.5pt] (-2,0) -- (0,2) -- (2,0) -- (0,-2) -- cycle;
					}
					{
						% Circle shape for independent source
						\draw[line width=\linewidthscalefactor * \zoomfactor * 1.5pt] (0,0) circle (2);
					}
				% draw terminals
					\draw[line width=\linewidthscalefactor * \zoomfactor * 1.5pt] (-3,0) -- (-2,0);
					\draw[line width=\linewidthscalefactor * \zoomfactor * 1.5pt] (2,0) -- (3,0);
				% draw +/- symbols
					% Plus sign on the left
					\draw[line width=\linewidthscalefactor * \zoomfactor * 0.8pt] (-1.2,0) -- (-0.4,0);
					\draw[line width=\linewidthscalefactor * \zoomfactor * 0.8pt] (-0.8,-0.4) -- (-0.8,0.4);
					% Minus sign on the right
					\draw[line width=\linewidthscalefactor * \zoomfactor * 0.8pt] (0.4,0) -- (1.2,0);
				% draw name
					\ifstrequal{#3}{horizontal}
						{
							\node[draw=none, anchor=south] at (0,2.2) {#2};
						}
						{
						}
					\ifstrequal{#3}{vertical}
						{
							\node[draw=none, anchor=east] at (-2.2,0) {#2};
						}
						{
						}
				% draw grid
					\ifstrequal{#6}{gridon}
						{
							\draw[step=1cm,color=gray] (-3,-3) grid (3,3);
						}
						{
						}
				% draw (0,0)
					\ifstrequal{#7}{show}
						{
							\node[draw=none, align=center, color=red] at (0,0) {#1};
						}
						{
						}
            \coordinate (pin1) at (-3.00, 0.00); % positive terminal  [R]
        \coordinate (pin2) at (3.00, 0.00); % negative terminal  [R]
    \end{scope}
}

%% Current Source (Independent/Controlled)
\newcommand{\currentsource}[7]{%{position}{name}{horizontal, vertical}{standard/controlled}{rotation}{grid}{show (0,0)}
% enabled
% category: Sources
% scales: 1, 2, 4
% label_anchor: 0 24 B
% flip: disabled
% spice_template: I_{NAME} {pin1} {pin2} {SIGNAL}
% preview_args: 3=horizontal, 4=standard, 5=0

% arg_def: 3 | select | horizontal/vertical  | horizontal | horizontal, vertical
% arg_def: 4 | select | standard/controlled | standard | standard, controlled
% arg_def: 5 | rotation | Rotation | 0


% icon_base: M -30 0 L -20 0 M 20 0 L 30 0 M -10 0 L 10 0 M 10 0 L 3 -5 L 10 0 L 3 5
% add_icon: 4==standard : [stroke-width=2.5] M 0 0 m -20 0 a 20 20 0 1 0 40 0 a 20 20 0 1 0 -40 0
% add_icon: 4==controlled : [stroke-width=2.5] M -20 0 L 0 -20 L 20 0 L 0 20 L -20 0
    \begin{scope}[shift={#1}, scale=\jlcscale, rotate=#5]
				\getzoomfactor			
					\ifstrequal{#3}{horizontal}
						{
							% Draw body
							\ifstrequal{#4}{controlled}
								{
									% Diamond shape for controlled source
									\draw[line width=\linewidthscalefactor * \zoomfactor * 1.5pt] (-2,0) -- (0,2) -- (2,0) -- (0,-2) -- cycle;
								}
