								\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt]  (1 + \currentselectterminal, \selY)  -- (1 + \currentselectterminal,  \muxheight+1); 
								\SUBTRACT{\numberofselectterminals}{\currentselectterminal}{\currentselectterminalindex}
								\IfEq{\numberofselectterminals}{1}
									{
										\node[draw=none, align=center] at (1.5 + \currentselectterminal,\muxheight+0.5) {s}; % draw select symbols
									}
									{
										\node[draw=none, align=center] at (1.5 + \currentselectterminal,\muxheight+0.5) {s\textsubscript{\currentselectterminalindex}}; % draw select symbols
									}
							}
						\ifstrequal{#2}{}	
							{
							}
							{					
								\node[draw=none, align=center] at ({1 + (\muxrectanglewidth / 2)},-1) {#2}; % draw name at bottom
							}
					}
					{
						\foreach \currentselectterminal in {1,...,\numberofselectterminals} % draw select lines at bottom
							{
								% Exact intersection with the slant: 0.4*i
								\pgfmathsetmacro{\selY}{0.4 * \currentselectterminal}
								\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt]  (1 + \currentselectterminal, \selY)  -- (1 + \currentselectterminal,  -1); 
								\SUBTRACT{\numberofselectterminals}{\currentselectterminal}{\currentselectterminalindex}
								\IfEq{\numberofselectterminals}{1}
									{
										\node[draw=none, align=center] at (1.5 + \currentselectterminal,-0.5) {s}; % draw select symbols
									}
									{
										\node[draw=none, align=center] at (1.5 + \currentselectterminal,-0.5) {s\textsubscript{\currentselectterminalindex}}; % draw select symbols
									}
							}
						\ifstrequal{#2}{}	
							{
							}
							{					
								\node[draw=none, align=center] at ({1 + (\muxrectanglewidth / 2)},\muxheight+1) {#2}; % draw name at top
							}
					}

				% draw body
					\pgfmathsetmacro{\outputY}{ceil((#3+1)/2)}
					\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt]  (\muxrectanglewidth + 1,\outputY)  -- (\muxrectanglewidth + 2,\outputY); % draw output line
					\node[draw=none, align=center] at (\muxrectanglewidth + 1.5,\outputY + 0.5) {O}; % draw output symbol
					
					\shade[left color=gray!50!white, draw=none] (1,0) -- (1, \muxheight) -- (1 + \muxrectanglewidth,\muxheight-0.4*\muxrectanglewidth) -- (1 + \muxrectanglewidth,0.4*\muxrectanglewidth) -- cycle; % draw shade
					\draw  [line width=\linewidthscalefactor * \zoomfactor * 1pt, color=gray!70]  (1,0) -- (1 + \muxrectanglewidth,\muxheight-0.4*\muxrectanglewidth); % draw diagonal
					\draw  [line width=\linewidthscalefactor * \zoomfactor * 1.5pt]  (1,0) -- (1, \muxheight) -- (1 + \muxrectanglewidth,\muxheight-0.4*\muxrectanglewidth) -- (1 + \muxrectanglewidth,0.4*\muxrectanglewidth) -- cycle; % draw box 
					
					% define dummy nodes
						\node[draw=none] (BL) at (1,0) {}; % bottom-left body corner
						\node[draw=none] (TL) at (1, \muxheight) {}; % top-left body corner
						\node[draw=none] (TR) at (1 + \muxrectanglewidth,\muxheight-0.4*\muxrectanglewidth) {}; % top-right body corner
						\node[draw=none] (BR) at (1 + \muxrectanglewidth,0.4*\muxrectanglewidth) {}; % bottom-right body corner
					%place numbers 
