					\IfEndWith{#3}{)}
						{
							\getzoomfactor
							\StrBetween{#3}{(}{)}[\cyclicnodes]
							\StrCount{\cyclicnodes -}{-}[\numcyclicnodes]
							% find proper margin value
								\setlength{\overallnodetextwidth}{0in}
								\ADD{\numcyclicnodes}{1}{\numcyclicnodesforlooplimit}
								\forloop{forloopcounter}{1}{\value{forloopcounter} < \numcyclicnodesforlooplimit}
								{
									\StrBefore[\value{forloopcounter}]{\cyclicnodes -}{-}[\cyclicnodetexttmp]
									\StrBehind[\value{forloopcounter}]{-\cyclicnodetexttmp}{-}[\cyclicnodetext]
									\addtolength{\overallnodetextwidth}{\widthof{\cyclicnodetext}}
									\addtolength{\overallnodetextwidth}{\widthof{WW}}% take into account 2 "safety" characters
								}
								% convert \overallnodetextwidth from pt to inches
									\edef\overallnodetextwidthinpt{\strip@pt\overallnodetextwidth}
									\MULTIPLY{0.01389}{\overallnodetextwidthinpt}{\overallnodetextwidthininches}
								\IfStrEq{#2}{auto}
									{
										% find circle perimeter in inches
											\MULTIPLY{2}{\overallnodetextwidthininches}{\circularpartperimeterininches}
										% find circle radius in inches
											\DIVIDE{\circularpartperimeterininches}{6.28}{\circularpartradiusininches}
										% find circle radius in centimeters
											\DIVIDE{\circularpartperimeterininches}{0.393701}{\circularpartradius}
											\edef\originalcircularpartradius{\circularpartradius}
									}
									{
										\edef\originalcircularpartradius{#2}							
									}
								% correct circle radius according to current zoom factor
									\ABSVALUE{\zoomfactor}{\abszoomfactor}
									\MULTIPLY{\originalcircularpartradius}{\abszoomfactor}{\circularpartradius}
								% find cyclic part perimeter (in cm)		
									\MULTIPLY{6.28}{\circularpartradius}{\circularpartperimeter}
								% convert cyclic part perimeter to inches		
									\MULTIPLY{0.393701}{\circularpartperimeter}{\circularpartperimeterininches}
								% find fraction of perimeter occupied by node circles 
									\DIVIDE{\overallnodetextwidthininches}{\circularpartperimeterininches}{\circularpartnodefraction}
								% find fraction of perimeter occupied by node circles (in degrees) 
									\MULTIPLY{\circularpartnodefraction}{360}{\circularpartnodefractiondegrees}
								% find degrees per node 
									\DIVIDE{\circularpartnodefractiondegrees}{\numcyclicnodes}{\circularpartnodefractiondegreespernode}
								% find final margin 
									\MULTIPLY{0.5}{\circularpartnodefractiondegreespernode}{\margin}
								% assign a +/-5% margin tolerance per node 
									\MULTIPLY{1.05}{\margin}{\margin}
	
							\getzoomfactor
							\begin{scope}[shift={($(L\numlinearnodesplusone) + (\originalcircularpartradius,0)$)}, xscale=-1]		
