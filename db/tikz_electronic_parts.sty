%%%%%%%%%%%%%%%%%%%%%
%% Timing Diagram
%%%%%%%%%%%%%%%%%%%%%
%
% define helper macro
\newcommand{\drawwaveform}[3]{%{position}{bitstream}{linecolor}
	% split bits and name
		\StrBefore{#2}{-}[\purebitstream]% bitstream
		\StrBehind{#2}{-}[\waveformname]% waveform name
	% find number of bits
		\StrLen{\purebitstream}[\numberofbitsinbitstream]
	% find bit length (given a timeline of length 15)
		\DIVIDE{15}{\numberofbitsinbitstream}{\bitstreambitlength}
	% generate don't-care rectangles
		\xdef\rectangleFlag{0}
		\xdef\rectangleshapestring{}
		\foreach \currentbitindex in {1, ..., \numberofbitsinbitstream} 
			{
				% get current bit value
					\StrChar{\purebitstream}{\currentbitindex}[\currentbitvalue]
				% get next bit value
					\ADD{\currentbitindex}{1}{\nextbitindex} 
					\StrChar{\purebitstream}{\nextbitindex}[\nextbitvalue] 
				% generate rectangle
					\IfStrEq{\rectangleFlag}{1}
						{
							\IfEq{\nextbitvalue}{X}
								{
								}
								{
									\xdef\rectangleendindex{\nextbitindex}
									\MULTIPLY{\rectanglestartindex}{\bitstreambitlength}{\rectangleleftXcoordinate}
									\MULTIPLY{\rectangleendindex}{\bitstreambitlength}{\rectanglerightXcoordinate}
									\xdef\rectangleshapestring{\rectangleshapestring  (\rectangleleftXcoordinate-\bitstreambitlength,0) rectangle (\rectanglerightXcoordinate-\bitstreambitlength,1)}												
									\xdef\rectangleFlag{0}								
								}
						}
						{
							\IfEq{\currentbitvalue}{X}
								{
									\xdef\rectangleFlag{1}
									\xdef\rectanglestartindex{\currentbitindex}
									\IfEq{\nextbitvalue}{X}
										{
										}
										{
											\xdef\rectangleendindex{\nextbitindex}
											\MULTIPLY{\rectanglestartindex}{\bitstreambitlength}{\rectangleleftXcoordinate}
											\MULTIPLY{\rectangleendindex}{\bitstreambitlength}{\rectanglerightXcoordinate}
											\xdef\rectangleshapestring{\rectangleshapestring  (\rectangleleftXcoordinate-\bitstreambitlength,0) rectangle (\rectanglerightXcoordinate-\bitstreambitlength,1)}												
											\xdef\rectangleFlag{0}								
										} 
								}
								{									
								}							
			
						}  			
			}		
	% generate point coordinate string
		\edef\pointcoordinatestring{(0,0)}
		\foreach \currentbitindex in {1, ..., \numberofbitsinbitstream} 
			{
				% get current bit value
					\StrChar{\purebitstream}{\currentbitindex}[\currentbitvalue]
				% detect don't-cares
					\IfEq{\currentbitvalue}{X}
						{
							\edef\currentbitvalue{0}
						}
						{
						}
				% get previous bit value
					\SUBTRACT{\currentbitindex}{1}{\previoustbitindex}
					\IfEq{\previoustbitindex}{0}
						{
							\edef\previousbitvalue{0}
						}
						{
							\StrChar{\purebitstream}{\previoustbitindex}[\previousbitvalue]
							% detect don't-cares
								\IfEq{\previousbitvalue}{X}
									{
										\edef\previousbitvalue{0}
									}
									{
									}				
						}
				% define points
					\MULTIPLY{\currentbitindex}{\bitstreambitlength}{\currentbitXcoordinate}
					\MULTIPLY{\previoustbitindex}{\bitstreambitlength}{\previousbitXcoordinate}
					% note the use of "xdef" !! :
					\xdef\pointcoordinatestring{\pointcoordinatestring{} -- (\previousbitXcoordinate ,\previousbitvalue) -- (\previousbitXcoordinate ,\currentbitvalue) -- ( \currentbitXcoordinate ,\currentbitvalue)}					
			}
	% draw waveform and its name
		\begin{scope}[shift={#1}, scale=\jlcscale]
			\getzoomfactor
			\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt, color=#3]  \pointcoordinatestring ;
			\node[anchor=east, color=#3] at (0,0) {\waveformname};
			% draw don't-care rectangles
				\fill [pattern=north west lines, pattern color=#3, line width=\linewidthscalefactor * \zoomfactor * 0.2pt] \rectangleshapestring ; 
				\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt, color=#3] \rectangleshapestring ; 
		\end{scope}
}
