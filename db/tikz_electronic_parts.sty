					}

				\ifstrequal{#5}{top}
					{
						\foreach \currentselectterminal in {1,...,\numberofselectterminals} % draw select lines at top
							{
								% Intersection with slant (DEMUX logic): h - 0.4 * (w - i)
								\pgfmathsetmacro{\selY}{\muxheight - 0.4 * (\muxrectanglewidth - \currentselectterminal)}
								\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt]  (1 + \currentselectterminal, \selY)  -- (1 + \currentselectterminal,  \muxheight+1); 
