%% Multiplexer with n inputs
\newcommand{\muxninputs}[7]{%{position}{name}{number of inputs}{rotation}{select at top/bottom}{grid}{show (0,0)}
% disabled
% category: Digital/Logic
% flip: disabled
		\begin{scope}[shift={#1}, scale=\jlcscale, rotate=#4, yshift=1]
				\getzoomfactor
				\LOG[2]{#3}{\numberofselectterminalstmp}				
				\FLOOR{\numberofselectterminalstmp}{\numberofselectterminalsfloor}
				\IfEq{\numberofselectterminalstmp}{\numberofselectterminalsfloor}
					{
						\ADD{0}{\numberofselectterminalsfloor}{\numberofselectterminals}
					}
					{
