%
% MAIN macro:
\newcommand{\dipic}[7]{%{position}{name}{rotation}{number of pins}{code}{grid}{show (0,0)}
% disabled
	% find width
		\IfEq{#5}{741}
			{
				\edef\numpinsperside{4}
			}
			{
				\IfBeginWith{#5}{74}
					{
						\edef\numpinsperside{7}
					}
					{
						\DIVIDE{#4}{2}{\numpinspersidetmp}
						\FLOOR{\numpinspersidetmp}{\numpinspersidefloor}
						\IfEq{\numpinspersidetmp}{\numpinspersidefloor}
							{
								\ADD{\numpinspersidefloor}{0}{\numpinsperside}
							}
							{
								\ADD{\numpinspersidefloor}{1}{\numpinsperside}
							}		
					}
			}		
	% draw		
		\begin{scope}[shift={#1}, scale=\jlcscale, rotate=#3]
			% draw pins
				\foreach \currenticside in {1, 2} 
					{
						\IfEq{\currenticside}{1}
							{
								\edef\pinverticalshift{0}
								\edef\pinrotation{0}
							}
							{
								\edef\pinverticalshift{6}
								\edef\pinrotation{180}
							}
						\foreach \currentpinindex in {1, ..., \numpinsperside} 
							{
								\begin{scope}[shift={(1+\currentpinindex,\pinverticalshift)}, rotate=\pinrotation]
									\shade[top color=gray!50!white, draw=none]   (-0.1,0)  -- (0.1,0) -- (0.3,1)  -- (-0.3,1) -- cycle;
									\draw [line width=\linewidthscalefactor * \zoomfactor * 0.75pt]  (-0.1,0)  -- (0.1,0) -- (0.3,1)  -- (-0.3,1) -- cycle;
									\coordinate (pin\currenticside .\currentpinindex) at (0,0); % ic pin
								\end{scope}
							}
					}
			% draw package body
				\shade[right color=gray!20!black, draw=none]  (1,1)  rectangle (2+\numpinsperside,5);
			% draw orientation mark
				\draw[fill=black]  (1,3.75)  arc (90:-90:0.75);
			% draw code
				\node[draw=none, align=center, color=black, rotate=90] at (3+\numpinsperside,3) {#5};
			% draw name
				\ifstrequal{#5}{}
					{
						\ADD{\numpinsperside}{3}{\iccanvaswidth}						
						\DIVIDE{\iccanvaswidth}{2}{\namehorizontalposition}
						\node[draw=none, align=center, color=white] at (\namehorizontalposition,3) {\textbf{#2}};
					}
					{
						\node[draw=none, align=center, color=blue, rotate=90] at (0,3) {#2};
					}
			% draw interior for known ICs
				\IfEq{#5}{7404}
					{
						\foreach \currenticside in {1, 2} 
							{
								\IfEq{\currenticside}{1}
									{
										\edef\gateverticalshift{0}
										\edef\gatehorizontalshift{0}
										\edef\gateyscale{1}
									}
									{
										\edef\gateverticalshift{18}
										\edef\gatehorizontalshift{5}
										\edef\gateyscale{-1}
									}
								\foreach \currentembeddedgate in {1, ..., 3} 
									{
										\begin{scope}[scale=0.2]
											\begin{scope}[shift={(\gatehorizontalshift + 10 * \currentembeddedgate , 6 + \gateverticalshift)}, yscale=\gateyscale, color=white]
													\getzoomfactor
													\tikzset{every path}=[line width=\linewidthscalefactor * \zoomfactor * 1.5pt]
													\inverter{(0,0)}{}{0}{gridoff}{showoff}
													\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt]  (0,2)  -- (0,-1);
													\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt]  (5,2)  -- (5,-1);
											\end{scope}
										\end{scope}
									}
							}
					}
					{
						% draw embedded gates
						\foreach \currenticside in {1, 2} 
							{
								\IfEq{\currenticside}{1}
									{
										\edef\gateverticalshift{0}
										\edef\gatehorizontalshift{11}
										\edef\gateyscale{1}
									}
									{
										\edef\gateverticalshift{11}
										\edef\gatehorizontalshift{15.5}
										\edef\gateyscale{-1}
									}
								\foreach \currentembeddedgate in {0,1} 
									{
										\begin{scope}[scale=0.22]
											\begin{scope}[shift={(\gatehorizontalshift + 14 * \currentembeddedgate , 8 + \gateverticalshift)}, yscale=\gateyscale, color=white]																				\getzoomfactor
												\IfEq{#5}{7408}{\andtwo{(0,0)}{}{0}{gridoff}{showoff} \drawembeddedgateconnections}{}
												\IfEq{#5}{7432}{\ortwo{(0,0)}{}{0}{gridoff}{showoff} \drawembeddedgateconnections}{}
												\IfEq{#5}{7400}{\nandtwo{(0,0)}{}{0}{gridoff}{showoff} \drawembeddedgateconnections}{}																
												\IfEq{#5}{7402}
													{
														\nortwoflipped{(5,0)}
														\begin{scope}[shift={(5,0)}, rotate=180, yscale=-1]
															\drawembeddedgateconnections									
														\end{scope}
													}{}								
											\end{scope}	
										\end{scope}
									}
							}
					}

			% draw package border
				\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt]  (1,1)  rectangle (2+\numpinsperside,5);

			% grid and coordinates
				\ifstrequal{#6}{gridon}
					{
						\draw[step=1cm,color=gray] (0,0) grid (3+\numpinsperside,6);
					}
					{
					}
				\ifstrequal{#7}{show}
					{
						\node[draw=none, align=center, color=red] at (0,0) {#1};
					}
					{
					}
		\end{scope}
}

