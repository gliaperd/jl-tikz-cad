				\draw  [line width=\linewidthscalefactor * \zoomfactor * 1.5pt]  (1,0) rectangle (6,\maxterminals+1); % draw box
				\node[draw=none, align=center] at (3.5,{(\maxterminals + 1)/ 2}) {#2}; % draw name at center
				% draw 'enable' terminal
					\IfStrEq{\genericcircuitwithenable}{enable}
						{
							\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt]  (0,1)  -- (1,1);
							\coordinate (pinEnable) at (0,1); % bottom left terminal (enable)
