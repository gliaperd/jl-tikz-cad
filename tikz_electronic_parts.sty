				{
				}
				{
					\drawwaveform{(0,2*\numberofbitstreams)}{#4}{brown}
					\ADD{1}{\numberofbitstreams}{\numberofbitstreams}
				}
			\ifstrequal{#5}{}
				{
				}
				{
					\drawwaveform{(0,2*\numberofbitstreams)}{#5}{magenta}
					\ADD{1}{\numberofbitstreams}{\numberofbitstreams}
				}
	\end{scope}
}

