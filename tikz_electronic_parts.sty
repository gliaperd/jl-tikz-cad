\newcommand{\linewidthscalefactor}{1}
%
\newcommand{\settikzlinewidth}[1]
% disabled!
{
\getzoomfactor
\IfStrEq{#1}{}
	{
		\renewcommand{\linewidthscalefactor}{1}
		\MULTIPLY{1.2}{\zoomfactor}{\thickbarthickness}
	}
	{
		\renewcommand{\linewidthscalefactor}{#1/ (1.5 * \zoomfactor)}
		\MULTIPLY{0.8}{#1}{\thickbarthickness}
	}
}
