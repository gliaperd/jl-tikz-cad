% define helper macros and environments:
\newcommand{\getzoomfactor}{%
\pgfgettransformentries{\myxscale}{\@tempa}{\@tempa}{\myyscale}{\@tempa}{\@tempa}
\IfEq{\myxscale}{0}
	{
		\xdef\zoomfactor{1}
	}
	{
		\xdef\zoomfactor{\myxscale}
	}
} 
