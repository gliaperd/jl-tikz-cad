%% Generic digital circuit (n-inputs, m-outputs)
\newcommand{\genericdigitalcircuit}[7]{%{position}{name}{number of inputs-enable}{number of outputs}{rotation}{grid}{show (0,0)}
% disabled
% category: Digital/Logic
% flip: disabled
		\StrBehind{#3}{-}[\genericcircuitwithenable]
		\StrBefore{#3}{-}[\numberofinputswithoutenable]
		\IfStrEq{\genericcircuitwithenable}{}
			{
				\edef\numberofinputterminals{#3}
				\edef\foreachstartindex{1}
				\edef\foreachsubtractvalue{1}
			}
			{
				\IfStrEq{\genericcircuitwithenable}{enable}
					{
						\ADD{\numberofinputswithoutenable}{2}{\numberofinputterminals}
						\edef\foreachstartindex{3}
						\edef\foreachsubtractvalue{3}
					}
					{
						\edef\numberofinputterminals{\numberofinputswithoutenable}
						\edef\foreachstartindex{1}
						\edef\foreachsubtractvalue{1}
					}
			}
		\begin{scope}[shift={#1}, scale=\jlcscale, rotate=#5, yshift=1]
				\getzoomfactor
				\MAX{\numberofinputterminals}{#4}{\maxterminals}
				\foreach \currentinput in {\foreachstartindex,...,\numberofinputterminals} % draw input lines
					{
						\SUBTRACT{\currentinput}{\foreachsubtractvalue}{\currentinputindex}
			
						\IfEq{\maxterminals}{\numberofinputterminals}
							{
								\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt]  (0,\currentinput)  -- (1,\currentinput);
								\coordinate (pinInput\currentinput) at (0,\currentinput); % left terminal (input-i)
								\IfEq{\numberofinputterminals}{1}
									{
										\node[draw=none, align=center] at (0.5, 0.5 + \currentinput) {I}; % draw input symbols
									}
									{
										\node[draw=none, align=center] at (0.5, 0.5 + \currentinput) {I\textsubscript{\currentinputindex}}; % draw input symbols
									}
							}
							{
								\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt]  (0,{\currentinput +  round((\maxterminals - \numberofinputterminals) / 2)})  -- (1,{\currentinput +  round((\maxterminals - \numberofinputterminals) / 2)});
								\coordinate (pinInput\currentinput) at (0,{\currentinput +  round((\maxterminals - \numberofinputterminals) / 2)}); % left terminal (input-i)
								\IfEq{\numberofinputterminals}{1}
									{
										\node[draw=none, align=center] at (0.5,{0.5 + \currentinput +  round((\maxterminals - \numberofinputterminals) / 2)}) {I}; % draw input symbols
									}
									{
										\node[draw=none, align=center] at (0.5,{0.5 + \currentinput +  round((\maxterminals - \numberofinputterminals) / 2)}) {I\textsubscript{\currentinputindex}}; % draw input symbols
									}
							}				
					}
				\foreach \currentoutput in {1,...,#4} % draw output lines
					{
						\SUBTRACT{\currentoutput}{1}{\currentoutputindex}

						\IfEq{\maxterminals}{#4}
							{
								\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt]  (6,\currentoutput)  -- (7,\currentoutput);
								\coordinate (pinOutput\currentoutput) at (7,\currentoutput); % right terminal (output-i)
								\IfEq{#4}{1}
									{
										\node[draw=none, align=center] at (6.5, 0.5 + \currentoutput) {O}; % draw output symbols
									}
									{
										\node[draw=none, align=center] at (6.5, 0.5 + \currentoutput) {O\textsubscript{\currentoutputindex}}; % draw output symbols
									}
							}
							{
								\draw [line width=\linewidthscalefactor * \zoomfactor * 1.5pt]  (6,{\currentoutput +  round((\maxterminals - #4) / 2)})  -- (7,{\currentoutput +  round((\maxterminals - #4) / 2)});
								\coordinate (pinOutput\currentoutput) at (7,{\currentoutput +  round((\maxterminals - #4) / 2)}); % right terminal (output-i)
								\IfEq{#4}{1}
									{
										\node[draw=none, align=center] at  (6.5,{0.5 + \currentoutput +  round((\maxterminals - #4) / 2)})  {O}; % draw output symbols
									}
									{
										\node[draw=none, align=center] at  (6.5,{0.5 + \currentoutput +  round((\maxterminals - #4) / 2)})  {O\textsubscript{\currentoutputindex}}; % draw output symbols
